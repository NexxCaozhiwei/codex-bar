<Window x:Class="CodexBar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Bar"
        Width="300"
        MinWidth="285"
        MinHeight="58"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Icon="Resources/CodexBar.ico"
        ShowActivated="True"
        ShowInTaskbar="False">
    <Border Background="{StaticResource PanelBrush}"
            BorderBrush="#364150"
            BorderThickness="1"
            CornerRadius="6"
            Padding="9,7"
            MouseLeftButtonDown="OnMouseLeftButtonDown"
            MouseMove="OnMouseMove"
            MouseLeftButtonUp="OnMouseLeftButtonUp"
            MouseRightButtonUp="OnMouseRightButtonUp">
        <Grid VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" MinWidth="0" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Codex" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="{Binding GreenLightBrush}" Margin="0,0,4,0" />
                    <Ellipse Width="7" Height="7" Fill="{Binding BlueLightBrush}" Margin="0,0,4,0" />
                    <Ellipse Width="7" Height="7" Fill="{Binding RedLightBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="4"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding ProjectDisplayText}"
                               MaxWidth="92"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="10"
                               Margin="0,0,4,0"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CurrentActionText}"
                               Foreground="{Binding StatusBrush}"
                               FontSize="10"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusDurationShortText}"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="10"
                               Margin="7,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <ItemsControl Grid.Row="1" ItemsSource="{Binding QuotaRows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="25" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="62" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Label}" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center" />
                            <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding RemainingPercent, Mode=OneWay}" Background="{StaticResource TrackBrush}">
                                <ProgressBar.Style>
                                    <Style TargetType="ProgressBar" BasedOn="{StaticResource QuotaProgressBarStyle}">
                                        <Setter Property="Foreground" Value="#3DA5FF" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStale}" Value="True">
                                                <Setter Property="Foreground" Value="#69717D" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>
                            <TextBlock Grid.Column="2" Text="{Binding Summary}" Foreground="{StaticResource TextBrush}" FontSize="10" TextAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</Window>
