<Window x:Class="CodexBar.DetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Bar 详情"
        Width="480"
        Height="520"
        MinWidth="440"
        MinHeight="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Icon="Resources/CodexBar.ico"
        Background="#1B1D24">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="Codex Bar 详情" FontSize="18" FontWeight="SemiBold" Foreground="#F4F7FB" />

        <ScrollViewer Grid.Row="1"
                      Margin="0,14,0,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <GroupBox Header="当前任务" Foreground="#F4F7FB" Padding="10" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="项目" Foreground="#9DA7B3" Margin="0,3" />
                        <TextBlock Grid.Column="1" Text="{Binding ProjectNameText}" Foreground="#F4F7FB" Margin="0,3" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="1" Text="当前状态" Foreground="#9DA7B3" Margin="0,3" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ActivityStateText}" Foreground="#F4F7FB" Margin="0,3" />

                        <TextBlock Grid.Row="2" Text="当前动作" Foreground="#9DA7B3" Margin="0,3" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CurrentActionText}" Foreground="#F4F7FB" Margin="0,3" />

                        <TextBlock Grid.Row="3" Text="简化命令" Foreground="#9DA7B3" Margin="0,3" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CurrentCommandText}" Foreground="#F4F7FB" Margin="0,3" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="4" Text="工作目录" Foreground="#9DA7B3" Margin="0,3" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding WorkingDirectoryText}" Foreground="#F4F7FB" Margin="0,3" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="5" Text="持续时间" Foreground="#9DA7B3" Margin="0,3" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding StatusDurationText}" Foreground="#F4F7FB" Margin="0,3" />

                        <TextBlock Grid.Row="6" Text="当前 Session" Foreground="#9DA7B3" Margin="0,3" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding CurrentSessionText}" Foreground="#F4F7FB" Margin="0,3" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="额度" Foreground="#F4F7FB" Padding="10" Margin="0,0,0,12">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding QuotaRows}" Margin="0,0,0,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Details}" Foreground="#F4F7FB" Margin="0,0,0,8" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding QuotaAccountDetails}" Foreground="#9DA7B3" TextWrapping="Wrap" />
                    </StackPanel>
                </GroupBox>

                <TextBlock Text="{Binding DetailStatusText}" Foreground="#9DA7B3" TextWrapping="Wrap" Margin="0,0,0,8" />
                <TextBlock Text="{Binding LastRefreshText, StringFormat=最近刷新：{0}}" Foreground="#9DA7B3" Margin="0,0,0,8" />
                <TextBlock Text="{Binding CodexPathText, StringFormat=Codex CLI：{0}}" Foreground="#9DA7B3" TextWrapping="Wrap" Margin="0,0,0,8" />
                <TextBlock Text="{Binding DataSourceText, StringFormat=数据来源：{0}}" Foreground="#9DA7B3" Margin="0,0,0,8" />
                <TextBlock Text="{Binding ErrorText}" Foreground="#FFB86B" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
